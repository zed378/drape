<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows TFM because the test reads and loads the Windows shell project. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Drape.Core\Drape.Core.csproj" />
    <ProjectReference Include="..\..\src\Drape.Infrastructure\Drape.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Drape.Shell.Windows\Drape.Shell.Windows.csproj" />
    <ProjectReference Include="..\..\src\Drape.UI\Drape.UI.csproj" />
    <ProjectReference Include="..\..\src\Drape.App.Desktop\Drape.App.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

</Project>
